TEAMUP_ENVIRONMENT=staging
TEAMUP_STORE_BACKEND=mysql
TEAMUP_DATABASE_URL=mysql+pymysql://<user>:<password>@<private-host>:3306/<database>?charset=utf8mb4
TEAMUP_ALLOW_LOCAL_LOGIN=false
TEAMUP_CORS_ORIGINS=
TEAMUP_WECHAT_APP_ID=<server-side-app-id>
TEAMUP_WECHAT_APP_SECRET=<server-side-app-secret>
TEAMUP_WECHAT_PROXY_URL=
TEAMUP_WECHAT_SESSION_ENDPOINT=https://api.weixin.qq.com/sns/jscode2session
TEAMUP_WECHAT_TIMEOUT_SECONDS=5
